# Copy to `.env` for local use; `.env` is git-ignored.

# API: comma-separated origins of the web app allowed to call it from a browser.
# Unset means the local defaults: http://localhost:5173 (dev) and http://localhost:4173 (preview).
WEB_ORIGINS=

# Snyk: token for running scans locally. In GitHub Actions, set SNYK_TOKEN as a repository
# secret instead (Settings → Secrets and variables → Actions). Get one at https://app.snyk.io/account
SNYK_TOKEN=
